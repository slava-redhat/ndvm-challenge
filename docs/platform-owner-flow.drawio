        <mxCell id="leg5" value="Python (deterministic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;" vertex="1" parent="leg"><mxGeometry x="174" y="66" width="140" height="26" as="geometry"/></mxCell>
        <mxCell id="leg6" value="Decision" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="leg"><mxGeometry x="14" y="106" width="90" height="26" as="geometry"/></mxCell>
        <mxCell id="leg7" value="Data source / feed" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="leg"><mxGeometry x="114" y="104" width="120" height="30" as="geometry"/></mxCell>
        <mxCell id="leg8" value="Fail-closed / refuse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="leg"><mxGeometry x="244" y="106" width="106" height="26" as="geometry"/></mxCell>

