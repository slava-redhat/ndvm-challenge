# --- Corporate Claude via Vertex (reasoning) ---------------------------------
# NOTE: podman-compose env_file needs plain KEY=VAL (no `export`).
CLAUDE_CODE_USE_VERTEX=1
CLOUD_ML_REGION=global
ANTHROPIC_VERTEX_PROJECT_ID=itpc-XXXXXXXX
NDVM_LLM_MODEL=vertex_ai/claude-sonnet-4-5@20250929
NDVM_FAST_LLM_MODEL=vertex_ai/claude-sonnet-4-5@20250929
# ADC file in repo root (gitignored): copy/symlink from
# ~/.config/gcloud/application_default_credentials.json
GOOGLE_APPLICATION_CREDENTIALS=./.application_default_credentials.json

# --- Embeddings (RAG): HOST Ollama, GPU via Vulkan (AMD 780M) -----------------
# Containers reach the host Ollama via host.containers.internal (see compose).
# The host daemon must listen beyond localhost so containers can reach it:
#   systemctl --user set-environment OLLAMA_HOST=0.0.0.0:11434 && systemctl --user restart ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_HOST=http://host.containers.internal:11434

# --- Postgres + pgvector (single DB: vectors + relational) -------------------
POSTGRES_USER=ndvm
POSTGRES_PASSWORD=ndvm
POSTGRES_DB=ndvm
PGHOST=db
PGPORT=5432

# Marquee CVEs the ingest job pulls (demo accounts + common RH-tracked NDVM cases)
INGEST_CVES=CVE-2024-3094,CVE-2023-3390,CVE-2024-1086,CVE-2024-6387,CVE-2023-44487,CVE-2021-44228,CVE-2022-0847,CVE-2021-4034,CVE-2023-4911,CVE-2023-38545,CVE-2024-21626,CVE-2019-5736,CVE-2022-0492,CVE-2022-42889,CVE-2024-2961
