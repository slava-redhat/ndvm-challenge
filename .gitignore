.env
# NEVER commit credentials — Vertex ADC lives in the repo dir but stays untracked.
*application_default_credentials.json
*.json.cred
__pycache__/
*.pyc
data/pdfs/*.pdf
.venv/
gcp/backups/*.sql.gz
ocp/backups/*.sql.gz

# docs excluded from this repo (design narrative kept locally)
docs/
pptx/
video/
jupyter/

# local editor / git tooling (keep on disk, never commit)
.claude/
.cursor/
.githooks/
